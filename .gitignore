# ── Python / FastAPI backend ─────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.eggs/

# Virtual environments
venv/
.venv/
env/
ENV/

# Environment variables / secrets
.env
.env.*
!.env.example

# ── Model artifacts & caches ─────────────────────────────────────────────
# Hugging Face model downloads (Chronos, TimesFM) — large, re-downloadable,
# never belongs in git
.cache/
huggingface_cache/
~/.cache/huggingface/

# Saved/fitted model files (LightGBM, joblib, pickled statsmodels objects)
*.joblib
*.pkl
*.pt
*.pth
*.ckpt

# ── Offline pipeline outputs ─────────────────────────────────────────────
# Generated by the model-selection/validation scripts — regeneratable,
# and the Excel workbooks especially don't belong in version control
outputs/
results/
*.xlsx
!**/sample_*.xlsx

# ── Data ──────────────────────────────────────────────────────────────────
# Uncomment if the raw sales CSVs shouldn't be committed (e.g. if they're
# large, sensitive, or regenerated). Left commented since this project's
# CSVs are small and the app needs them present to run locally.
# app/data/raw/*.csv
# backend/data/*.csv

# ── Frontend (React / Vite) ──────────────────────────────────────────────
node_modules/
dist/
build/
.vite/
*.local

# ── IDE / editor ──────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── OS junk ────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Logs ───────────────────────────────────────────────────────────────────
*.log
/scripts
/scripts/*.py